# Copy to .env at the repository root. e87ctl loads it at startup; a real
# environment variable always wins, so `E87CTL_PROFILE=bench uv run e87ctl ...`
# still overrides a line here for one command.
#
# Every variable stands in for a flag: flag, then environment, then prompt.
# .env is ignored by git. Keep the recovery package itself outside the checkout;
# it holds the installation CA private key.

# Installation recovery package. Read by `e87ctl provision --installation`, and
# the destination of `e87ctl installation create --output`. The public CA
# certificate is the `-ca.pem` sidecar beside it, so it needs no variable:
# ~/e87canbus/installation.json pairs with ~/e87canbus/installation-ca.pem.
E87CTL_INSTALLATION=~/e87canbus/installation.json

# Deployment profile for `e87ctl provision`: car or bench. Owns device sources,
# network enablement, TX grants, and development API capabilities.
E87CTL_PROFILE=bench
