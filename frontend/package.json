{
  "name": "e87canbus-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names vite,contracts \"vite\" \"pnpm api:watch\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "live:generate": "uv run --project .. python ../scripts/generate_live_contract.py && node scripts/generate-live-contract.mjs",
    "live:check": "uv run --project .. python ../scripts/generate_live_contract.py --check && node scripts/generate-live-contract.mjs --check",
    "http:generate": "openapi-ts",
    "http:check": "node scripts/check-http-contract.mjs",
    "api:generate": "uv run --project .. python ../scripts/generate_openapi.py && pnpm http:generate && pnpm live:generate",
    "api:check": "uv run --project .. python ../scripts/generate_openapi.py --check && pnpm http:check && pnpm live:check",
    "api:watch": "uv run --project .. python ../scripts/watch_frontend_contracts.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/oxanium": "^5.2.8",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-virtual": "^3.14.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "3.8.0",
    "shadcn": "^4.13.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@hey-api/openapi-ts": "0.99.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/router-plugin": "^1.168.20",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "9.2.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.15.1"
}
