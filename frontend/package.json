{
  "name": "e87canbus-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names coordinator,console,contracts \"pnpm dev:coordinator\" \"pnpm dev:console\" \"pnpm api:watch\"",
    "dev:coordinator": "pnpm --filter @e87canbus/coordinator dev",
    "dev:console": "pnpm --filter @e87canbus/console dev",
    "build": "pnpm --filter './apps/*' build",
    "build:coordinator": "pnpm --filter @e87canbus/coordinator build",
    "build:console": "pnpm --filter @e87canbus/console build",
    "lint": "eslint .",
    "test": "pnpm --recursive --workspace-concurrency=1 test",
    "typecheck": "pnpm --recursive typecheck",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx}\"",
    "live:generate": "uv run --project .. python ../scripts/generate_live_contract.py && node scripts/generate-live-contract.mjs && pnpm --filter @e87canbus/console live:generate",
    "live:check": "uv run --project .. python ../scripts/generate_live_contract.py --check && node scripts/generate-live-contract.mjs --check && pnpm --filter @e87canbus/console live:check",
    "http:generate": "openapi-ts && node scripts/generate-button-command-catalogue.mjs",
    "http:check": "node scripts/check-http-contract.mjs && node scripts/generate-button-command-catalogue.mjs --check",
    "api:generate": "uv run --project .. python ../scripts/generate_openapi.py && pnpm http:generate && pnpm live:generate",
    "api:check": "uv run --project .. python ../scripts/generate_openapi.py --check && pnpm http:check && pnpm live:check",
    "api:watch": "uv run --project .. python ../scripts/watch_frontend_contracts.py"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@hey-api/openapi-ts": "0.99.0",
    "concurrently": "9.2.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8"
  },
  "packageManager": "pnpm@9.15.1"
}
