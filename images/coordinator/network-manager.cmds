--offline connection add type ethernet ifname eth0 con-name e87canbus-console-link connection.autoconnect yes ipv4.method manual ipv4.addresses 10.43.0.1/30 ipv4.gateway '' ipv4.dns '' ipv4.ignore-auto-dns yes ipv4.never-default yes ipv4.routes '0.0.0.0/0 type=blackhole table=501' ipv4.routing-rules 'priority 101 iif eth0 table 501' ipv6.method disabled > /etc/NetworkManager/system-connections/e87canbus-console-link.nmconnection
--offline connection add type wifi ifname wlan0 con-name e87canbus-hotspot ssid e87canbus connection.autoconnect no connection.permissions '' 802-11-wireless.mode ap 802-11-wireless.ssid e87canbus 802-11-wireless-security.key-mgmt wpa-psk ipv4.method shared ipv4.addresses 10.42.0.1/24 ipv4.never-default yes ipv4.routes '0.0.0.0/0 type=blackhole table=500' ipv4.routing-rules 'priority 100 iif wlan0 table 500' ipv6.method disabled > /etc/NetworkManager/system-connections/e87canbus-hotspot.nmconnection
