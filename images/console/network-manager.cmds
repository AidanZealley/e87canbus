--offline connection add type ethernet ifname eth0 con-name e87canbus-console-link connection.autoconnect yes ipv4.method manual ipv4.addresses 10.43.0.2/30 ipv4.gateway '' ipv4.dns '' ipv4.ignore-auto-dns yes ipv4.never-default yes ipv4.routes '0.0.0.0/0 type=blackhole table=501' ipv4.routing-rules 'priority 101 iif eth0 table 501' ipv6.method disabled > /etc/NetworkManager/system-connections/e87canbus-console-link.nmconnection
