[Unit]
Description=E87 kiosk display (cage)
After=e87canbus-controller.service systemd-logind.service systemd-user-sessions.service
Conflicts=getty@tty7.service

[Service]
Type=simple
User=KIOSK_USER_PLACEHOLDER
PAMName=login
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=7
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
# systemd attaches the service to tty7 but does not make that VT active. Cage's DRM backend times
# out unless logind marks its session active before startup.
ExecStartPre=+/usr/bin/chvt 7
ExecStart=/usr/bin/cage -s -- /usr/local/bin/e87canbus-kiosk
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
