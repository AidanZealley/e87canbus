#!/usr/bin/env python3

from __future__ import annotations

import sys
from pathlib import Path

LAUNCHER = """#!/bin/sh
'''exec' "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/python3" "$0" "$@"
' '''
"""


def main(paths: list[str]) -> int:
    if not paths:
        return 2
    for value in paths:
        path = Path(value)
        contents = path.read_text()
        first_line, separator, body = contents.partition("\n")
        if not separator or not first_line.startswith("#!") or "python" not in first_line:
            raise ValueError(f"{path} is not a Python entry point")
        path.write_text(LAUNCHER + body)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
