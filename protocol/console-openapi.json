{
  "components": {
    "schemas": {
      "ConsoleCanState": {
        "additionalProperties": false,
        "properties": {
          "connected": {
            "title": "Connected",
            "type": "boolean"
          },
          "fault": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fault"
          },
          "frames_received": {
            "minimum": 0.0,
            "title": "Frames Received",
            "type": "integer"
          },
          "interface": {
            "const": "kcan",
            "default": "kcan",
            "title": "Interface",
            "type": "string"
          }
        },
        "required": [
          "connected",
          "frames_received",
          "fault"
        ],
        "title": "ConsoleCanState",
        "type": "object"
      },
      "ConsoleSnapshotData": {
        "additionalProperties": false,
        "properties": {
          "can": {
            "$ref": "#/components/schemas/ConsoleCanState"
          }
        },
        "required": [
          "can"
        ],
        "title": "ConsoleSnapshotData",
        "type": "object"
      },
      "ConsoleSnapshotEvent": {
        "additionalProperties": false,
        "description": "Complete local state sent by the console host's SSE endpoint.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ConsoleSnapshotData"
          },
          "type": {
            "const": "console.snapshot",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "data"
        ],
        "title": "ConsoleSnapshotEvent",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "E87 Console",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/live": {
      "get": {
        "operationId": "stream_console_live_api_live_get",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ConsoleSnapshotEvent"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Stream Console Live"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Liveness Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness"
      }
    }
  }
}
